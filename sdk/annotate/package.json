  "description": "Embeddable multi-participant screen annotation. Renders on the sharer's real desktop, so every viewer sees it through the ordinary video path. Jitsi transport included.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js",
    "./surface": "./surface/surface.js",
    "./overlay": "./overlay/overlay.js",
    "./transport/jitsi": "./transport/jitsi.js"
  },
  "files": [
    "core",
    "surface",
    "overlay",
    "transport",
    "latency",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "verify-bundles": "node test/verify-bundles.mjs",
    "check": "npm test && npm run verify-bundles"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  }
}
